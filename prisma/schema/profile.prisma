// @polsia:user-owned — matching-feed Profile API.
//
// Linked to better-auth's `User` by a SCALAR `userId` only (no Prisma
// `@relation` back to `User`). `auth.prisma` is framework-owned and the better-
// auth AGENT.md forbids editing it to add a back-relation field. The Profile
// row is read/written by id (`prisma.user.findUnique({ where: { id: userId } })`)
// at the call site.
//
// The framework-owned `prisma/schema/_base.prisma` declares datasource +
// generator — do NOT redeclare them here.

enum VerificationStatus {
  unverified
  pending
  approved
  rejected
}

// Profile moderation lifecycle. Questionnaire persistence starts in DRAFT so
// partially completed onboarding never enters the admin review queue. Slice 4
// owns the explicit DRAFT → PENDING submit-for-review transition. Existing
// PENDING / APPROVED / FLAGGED rows retain their meanings.
enum ReviewStatus {
  DRAFT
  PENDING
  APPROVED
  FLAGGED
}

model Profile {
  id                String             @id @default(cuid())
  userId            String             @unique
  displayName       String?
  age               Int
  location          String
  interests         String[]
  // Legacy compatibility field for free-form self-description and preference
  // tags. Preserve it independently; it is not a second matching signal.
  lifestylePreferences String[]         @default([])
  // Canonical structured lifestyle taxonomy for future approved structured work.
  // It is additive with a safe default: never backfill or translate arbitrary
  // legacy lifestylePreferences strings into this closed vocabulary here.
  relationshipIntent String?
  distancePreference String?
  lifestyleCharacteristics String[]     @default([])
  valuesPriorities  String[]            @default([])
  partnerPreferences String[]           @default([])
  bio               String?
  // Public Vercel Blob URL. Set/unset by the signed completion callback and
  // DELETE /api/profile/avatar; clients never set this through ProfilePatch.
  avatarUrl         String?
  // Owner-only ID verification state. Flipped to `pending` by POST on
  // /api/profile/verification-id; admin review will set `approved`/`rejected`.
  verificationStatus VerificationStatus? @default(unverified)
  // Saved onboarding data is a draft until Slice 4 explicitly submits it.
  // Admin moderation APIs exclude DRAFT rows.
  reviewStatus      ReviewStatus       @default(DRAFT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([location])
  @@index([age])
  @@index([reviewStatus, createdAt])
}

// One pending or reviewed ID-verification submission per user. Scalar `userId`
// only — never `@relation` back to `User` (auth.prisma is framework-owned and
// cannot host a back-relation). `@@map("id_verification")` so the physical
// table name cannot collide with better-auth's `verification` email-token
// table even if a future migration changes the spelling.
model IdVerification {
  id          String           @id @default(cuid())
  userId      String           @unique
  // Private Vercel Blob URL while review is pending. Cleared immediately
  // after an admin decision; clients never receive this value from app APIs.
  imagePath   String?
  status      VerificationStatus
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?

  @@map("id_verification")
}
